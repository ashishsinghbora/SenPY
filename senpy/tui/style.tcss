Screen {
    background: $surface;
    color: $text;
}

Header {
    dock: top;
    height: 1;
    background: $primary;
    color: $text;
}

Footer {
    dock: bottom;
    height: 1;
    background: $primary-darken-2;
}

#main-screen-layout {
    height: 100%;
    width: 100%;
}

#browse-container {
    height: 60%;
    width: 100%;
}

#left-pane {
    width: 38%;
    height: 100%;
    border-right: solid $primary;
    padding: 0 1;
}

#right-pane {
    width: 62%;
    height: 100%;
    padding: 0 1;
}

.pane-header {
    text-style: bold;
    color: $accent;
    background: $panel;
    padding: 0 1;
    margin-bottom: 1;
    width: 100%;
}

#search-input {
    width: 100%;
    border: tall $primary;
    margin-bottom: 1;
}

#search-results {
    height: 1fr;
    background: $surface-darken-1;
    border: round $primary-darken-2;
}

.search-item-label {
    padding: 0 1;
}

.empty-msg {
    color: $text-muted;
    padding: 1 2;
    text-align: center;
}

.anime-panel-container {
    height: 100%;
    padding: 0 1;
}

.panel-title {
    text-style: bold;
    color: $accent;
}

.panel-meta {
    color: $text-muted;
    margin-bottom: 1;
}

.panel-subinfo {
    color: $secondary;
    margin-bottom: 1;
}

.panel-synopsis {
    color: $text;
    background: $surface-darken-1;
    padding: 1;
    border: round $primary-darken-3;
    max-height: 8;
    margin-bottom: 1;
}

.section-heading {
    text-style: bold;
    color: $secondary;
    margin-top: 1;
}

.form-input {
    margin-bottom: 1;
}

.form-select {
    margin-bottom: 1;
}

.form-checkbox {
    margin-bottom: 1;
}

.action-button {
    width: 100%;
    margin-top: 1;
    text-style: bold;
}

#transfer-center {
    height: 40%;
    width: 100%;
    border-top: solid $accent;
    background: $surface-darken-1;
    padding: 0 1;
}

#transfer-header {
    text-style: bold;
    color: $accent;
    padding: 0 1;
    width: 100%;
    background: $panel;
    margin-bottom: 1;
}

#downloads-scroll {
    height: 1fr;
    width: 100%;
}

.download-card {
    height: auto;
    border: round $primary-darken-1;
    background: $surface;
    padding: 0 1;
    margin-bottom: 1;
}

.dl-header {
    height: 1;
    width: 100%;
}

.dl-title {
    text-style: bold;
    color: $text;
    width: 1fr;
}

.dl-badge {
    padding: 0 1;
    text-style: bold;
}

.badge-queued {
    background: $warning-darken-2;
    color: $text;
}

.badge-downloading {
    background: $primary;
    color: $text;
}

.badge-finished {
    background: $success;
    color: $text;
}

.badge-error {
    background: $error;
    color: $text;
}

.dl-bar {
    width: 100%;
    margin: 0;
}

.dl-stats {
    color: $text-muted;
}

/* Modal Settings Dialog */
SettingsModal {
    align: center middle;
}

#settings-modal-dialog {
    width: 68;
    height: auto;
    max-height: 85%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

.modal-title {
    text-style: bold;
    color: $accent;
    text-align: center;
    width: 100%;
    margin-bottom: 1;
}

.modal-scroll {
    max-height: 18;
    margin-bottom: 1;
}

.modal-input {
    margin-bottom: 1;
}

.modal-buttons {
    width: 100%;
    align-horizontal: right;
}

.modal-buttons Button {
    margin-left: 1;
}
