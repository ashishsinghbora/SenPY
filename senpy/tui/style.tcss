Screen {
    background: #1a1b26;
    color: #c0caf5;
}

Header {
    background: #16161e;
    color: #7aa2f7;
    text-style: bold;
    dock: top;
    height: 3;
}

Footer {
    background: #16161e;
    color: #a9b1d6;
    dock: bottom;
    height: 1;
}

#nav-bar {
    dock: top;
    height: 3;
    background: #1f2335;
    padding: 0 1;
    align: center middle;
}

.nav-btn {
    margin: 0 1;
    background: #24283b;
    color: #7aa2f7;
    border: none;
    min-width: 14;
}

.nav-btn:hover {
    background: #3b4261;
    color: #bb9af7;
}

.nav-btn.-active {
    background: #7aa2f7;
    color: #1a1b26;
    text-style: bold;
}

#search-container {
    padding: 1 2;
    layout: vertical;
}

#search-input {
    dock: top;
    margin-bottom: 1;
    border: tall #3b4261;
    background: #1f2335;
    color: #c0caf5;
}

#search-input:focus {
    border: tall #7aa2f7;
}

#search-body {
    layout: horizontal;
    height: 1fr;
}

#results-list {
    width: 60%;
    height: 100%;
    border: round #3b4261;
    background: #16161e;
    padding: 0 1;
}

#detail-pane {
    width: 40%;
    height: 100%;
    border: round #3b4261;
    background: #1f2335;
    padding: 1 2;
    margin-left: 1;
    layout: vertical;
}

.detail-title {
    text-style: bold;
    color: #7aa2f7;
    margin-bottom: 1;
}

.detail-meta {
    color: #9ece6a;
    margin-bottom: 1;
}

.detail-synopsis {
    color: #a9b1d6;
    height: 1fr;
    overflow-y: auto;
}

#episodes-container {
    padding: 1 2;
    layout: vertical;
    align: center top;
}

.panel-card {
    width: 80%;
    border: round #3b4261;
    background: #1f2335;
    padding: 1 2;
    margin-top: 1;
}

.form-label {
    color: #bb9af7;
    text-style: bold;
    margin-top: 1;
}

.action-btn {
    background: #7aa2f7;
    color: #1a1b26;
    text-style: bold;
    margin-top: 2;
    min-width: 20;
    border: none;
}

.action-btn:hover {
    background: #9ece6a;
}

#downloads-container {
    padding: 1 2;
    layout: vertical;
}

#downloads-header {
    height: 3;
    background: #1f2335;
    padding: 0 1;
    align: center middle;
    margin-bottom: 1;
    border: round #3b4261;
}

#downloads-list {
    height: 1fr;
    border: round #3b4261;
    background: #16161e;
    overflow-y: auto;
    padding: 1;
}

.dl-card {
    height: 4;
    background: #1f2335;
    border: round #3b4261;
    margin-bottom: 1;
    padding: 0 1;
}

.dl-label {
    text-style: bold;
    color: #c0caf5;
}

.dl-speed {
    color: #9ece6a;
}

#settings-container {
    padding: 1 2;
    align: center top;
}

.setting-row {
    margin-bottom: 1;
}
